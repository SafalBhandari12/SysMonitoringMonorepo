datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum methodEnum {
  GET
  POST
  PUT
  DELETE
  PATCH
}

enum apiStatusEnum {
  UP
  DOWN
  TIMEOUT
}

enum incidentStatusEnum {
  ONGOING
  RESOLVED
}

enum plans {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum regions {
  SA
  SG
  EU
  US
  IN
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]
  onboarded     Boolean         @default(false)

  domains       Domain?
  apiGroups     ApiGroup[]
  apiKeys       ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String @id @default(uuid())
  key       String @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Domain {
  id String @id @default(uuid())

  domain String @unique

  verificationStatus      DomainVerificationStatus @default(PENDING)
  verificationCode        String                   @default(cuid())
  lastVerificationAttempt DateTime?
  verificationAttempts    Int                      @default(0)
  verifiedAt              DateTime?

  apis Api[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model ApiGroup {
  id String @id @default(uuid())

  name        String
  description String?

  apis Api[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Api {
  id String @id @default(uuid())

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id])

  apiGroupId String
  apiGroup   ApiGroup? @relation(fields: [apiGroupId], references: [id])

  path String

  name        String
  method      methodEnum
  headers     Json?
  body        Json?
  pathParams  Json?
  queryParams Json?

  response   ApiResponse[]
  dailyStats DailyStats[]
  metrics    ApiMetrics[]
  incidents  Incident[]

  processingStatus Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domainId, path])
}

model ApiMetrics {
  id String @id @default(uuid())

  apiId String
  api   Api    @relation(fields: [apiId], references: [id], onDelete: Cascade)

  region regions

  averageResponseTime Float @default(0) // in milliseconds
  p90ResponseTime     Float @default(0) // in milliseconds
  p99ResponseTime     Float @default(0) // in milliseconds

  upCount    Int @default(0)
  totalCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([apiId, region])
}

model ApiResponse {
  id    String @id @default(uuid())
  apiId String

  responseTime Int // in milliseconds
  statusCode   Int
  status       apiStatusEnum
  region       regions

  createdAt DateTime @default(now())

  api Api @relation(fields: [apiId], references: [id])

  @@index([apiId, createdAt(sort: Desc)])
}

model DailyStats {
  id    String @id @default(uuid())
  apiId String
  api   Api    @relation(fields: [apiId], references: [id])

  date DateTime

  region regions

  upCount    Int @default(0)
  totalCount Int @default(0)

  @@unique([date, region])
}

model Incident {
  id String @id @default(uuid())

  title       String
  description String?

  regions regions[]

  apiId String
  api   Api    @relation(fields: [apiId], references: [id])

  startTime DateTime  @default(now())
  endTime   DateTime?

  status incidentStatusEnum @default(ONGOING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apiId, createdAt(sort: Desc)])
}
