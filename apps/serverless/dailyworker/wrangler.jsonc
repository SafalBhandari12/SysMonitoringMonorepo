{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sys-monitoring-corn-job",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-05",
	"observability": {
		"enabled": true,
	},
	"compatibility_flags": ["nodejs_compat"],
	/**
